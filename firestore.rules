rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /properties/{propertyId} {
      // Anyone with the direct link can view a single property (the apply
      // page) - this always worked regardless of isPubliclyListed, and
      // still does. The collection can be listed either by its owner
      // (their own /homeowner/properties dashboard) or, as of the public
      // /browse page, by anyone querying for publicly-listed + active
      // properties specifically - the query itself must filter on both
      // fields for Firestore to prove this rule is satisfied for a list.
      allow get: if true;
      allow list: if (request.auth != null && request.auth.uid == resource.data.ownerId)
        || (resource.data.isPubliclyListed == true && resource.data.status == "active");
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }

    match /applications/{applicationId} {
      // Covers both get and list; Firestore evaluates this per-document for
      // list queries too, so a renter's "my applications" query and an
      // owner's "applications for this property" query both work.
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.renterId || request.auth.uid == resource.data.ownerId);
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.renterId &&
        request.resource.data.ownerId ==
          get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.ownerId;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.ownerId ||
        (request.auth.uid == resource.data.renterId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['renter']))
      );
      allow delete: if request.auth != null &&
        (request.auth.uid == resource.data.renterId || request.auth.uid == resource.data.ownerId);
    }
  }
}
